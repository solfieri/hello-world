tip: “Sem sal e sem cobertura. Calorias altas — não exagerar na quantidade. Castanha-do-pará: máximo 2 unidades/dia (selênio em excesso é tóxico).”
},
{
name: “Alho”,
detail: “1–2 dentes/dia, preferencialmente cru ou adicionado no final do cozimento. Aliina tem leve efeito redutor de LDL e anti-inflamatório vascular.”,
tip: “Amassar e deixar repousar 10 min antes de usar ativa a alicina. Excelente em molhos, saladas e refogados leves.”
},
]
},
{
id: “recomendaveis”,
label: “Recomendáveis”,
subtitle: “Incluir com frequência semanal”,
color: “#1a4a7a”,
bg: “#f0f6ff”,
accent: “#2563eb”,
icon: “◆”,
foods: [
{
name: “Abacate”,
