icon: “▲”,
foods: [
{
name: “Carne vermelha magra”,
detail: “Patinho, coxão mole, alcatra, filé mignon — cortes com < 10% de gordura. Máximo 1–2x/semana, porções de 100–120g.”,
tip: “Nunca a carne processada no lugar. Retirar toda gordura visível antes de cozinhar. Preferir grelhada ou assada.”
},
{
name: “Leite e queijos semidesnatados”,
detail: “Leite desnatado ou semidesnatado é aceitável. Queijos: ricota, cottage, queijo minas frescal (light). Mozzarella de búfala com moderação.”,
tip: “Queijos amarelos (prato, cheddar, gouda, parmesão) têm alto teor de gordura saturada — evitar frequência diária.”
},
{
name: “Camarão e frutos do mar”,
detail: “São ricos em colesterol dietético, mas relativamente baixos em gordura saturada. Aceitável 1x/semana em porções moderadas (100g).”,
tip: “O impacto do colesterol dietético no LDL é menor que o da gordura saturada. A preocupação com camarão é menor do que com carne gordurosa.”
},
{
name: “Pão branco, arroz branco, massas refinadas”,
detail: “Não elevam diretamente o LDL, mas têm baixo valor nutricional e podem elevar triglicerídeos. Substituir gradualmente pelas versões integrais.”,
tip: “A transição para integrais pode ser feita misturando (50% integral + 50% refinado) até adaptação do paladar.”
},
{
name: “Álcool”,
